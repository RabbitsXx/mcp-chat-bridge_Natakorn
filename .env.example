# Copy to .env and adjust — used by scripts/start.sh and src/server.mjs
# (generate a token: openssl rand -hex 32)

# Directories the MCP filesystem server may access (space-separated)
ROOTS=F:/MyWork/your-project

# Command that launches the MCP stdio server (any stdio MCP server works)
MCP_COMMAND=npx -y @modelcontextprotocol/server-filesystem

# Local gateway / bridge ports
GATEWAY_PORT=8791
PORT=8792

# Token required by the REST bridge (required, no default)
BRIDGE_TOKEN=

# Executables (default to PATH)
NODE_BIN=node
CLOUDFLARED_BIN=cloudflared
